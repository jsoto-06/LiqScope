# ==============================================================================
# LiqScope - Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit credentials or API keys to version control.
# ==============================================================================

# Entorno de ejecución: 'demo', 'development', 'production', 'test'
LIQSCOPE_ENV=demo

# Configuración del servidor de la API
LIQSCOPE_HOST=0.0.0.0
LIQSCOPE_PORT=8000
LIQSCOPE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LIQSCOPE_LOG_LEVEL=INFO

# Persistencia (SQLite para dev/demo; actualizable a PostgreSQL/TimescaleDB)
LIQSCOPE_DATABASE_URL=sqlite+aiosqlite:///./data/liqscope.db
LIQSCOPE_DATA_DIR=./data

# Rutas de endpoints oficiales de exchanges (Solo lectura pública)
# Binance Futures USDT-M
LIQSCOPE_BINANCE_WS_URL=wss://fstream.binance.com/ws
LIQSCOPE_BINANCE_REST_URL=https://fapi.binance.com

# Bybit Linear
LIQSCOPE_BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
LIQSCOPE_BYBIT_REST_URL=https://api.bybit.com

# Hyperliquid Info API (on-chain reading)
LIQSCOPE_HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info

# Robustez y resiliencia de conexiones
LIQSCOPE_WS_RECONNECT_MIN_DELAY_SEC=1.0
LIQSCOPE_WS_RECONNECT_MAX_DELAY_SEC=60.0
LIQSCOPE_WS_RECONNECT_JITTER=0.25
LIQSCOPE_HTTP_REQUEST_TIMEOUT_SEC=10.0
LIQSCOPE_STALE_DATA_THRESHOLD_SEC=30.0

# Archivo de pesos y distribución de apalancamientos típicos
LIQSCOPE_DISTRIBUTION_CONFIG_PATH=./config/default_distribution.yaml
